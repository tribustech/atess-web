# atess-web-next env example
# Copy to .env.local and fill in values

# Configurator email (Postmark)
POSTMARK_API_KEY=
POSTMARK_FROM=configurator@atess.ro
POSTMARK_STREAM=outbound
TEAM_EMAIL=teo@atess.ro

# Sveltia CMS — GitHub OAuth relay (/admin)
# Create a GitHub OAuth App with callback URL: https://atessproject.ro/api/auth/callback
CMS_GITHUB_CLIENT_ID=
CMS_GITHUB_CLIENT_SECRET=
# Pins the OAuth redirect base in production (avoids depending on request host).
CMS_OAUTH_BASE_URL=https://atessproject.ro
